{
  "schemaVersion": 1,
  "name": "Jarvis Interface",
  "author": "DeskPet Jarvis",
  "version": "1.0.0",
  "description": "Arc-reactor HUD assistant: glowing cyan core, rotating data rings and radar pings. Built for the DeskPet Jarvis hackathon build.",
  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 200,
    "height": 200
  },
  "layout": {
    "contentBox": {
      "x": 36,
      "y": 26,
      "width": 128,
      "height": 132
    },
    "centerX": 100,
    "baselineY": 178,
    "visibleHeightRatio": 0.62,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": [
      "idle"
    ],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.45,
    "maxOffset": 3,
    "trackingLayers": {
      "eyes": {
        "ids": [
          "sensor-left",
          "sensor-right"
        ],
        "maxOffset": 3,
        "ease": 0.2
      }
    }
  },
  "sleepSequence": {
    "mode": "direct"
  },
  "states": {
    "idle": [
      "jarvis-idle.svg"
    ],
    "thinking": [
      "jarvis-thinking.svg"
    ],
    "working": [
      "jarvis-working.svg"
    ],
    "juggling": [
      "jarvis-working.svg"
    ],
    "sweeping": [
      "jarvis-sweeping.svg"
    ],
    "carrying": [
      "jarvis-carrying.svg"
    ],
    "error": [
      "jarvis-error.svg"
    ],
    "attention": [
      "jarvis-attention.svg"
    ],
    "notification": [
      "jarvis-notification.svg"
    ],
    "sleeping": [
      "jarvis-sleeping.svg"
    ]
  },
  "workingTiers": [
    {
      "minSessions": 2,
      "file": "jarvis-working.svg"
    },
    {
      "minSessions": 1,
      "file": "jarvis-working.svg"
    }
  ],
  "reactions": {
    "drag": {
      "file": "jarvis-react-drag.svg"
    },
    "clickLeft": {
      "file": "jarvis-react-spark.svg",
      "duration": 2200
    },
    "double": {
      "files": [
        "jarvis-react-double.svg"
      ],
      "duration": 3000
    }
  },
  "hitBoxes": {
    "default": {
      "x": 52,
      "y": 44,
      "w": 96,
      "h": 96
    },
    "sleeping": {
      "x": 52,
      "y": 44,
      "w": 96,
      "h": 96
    }
  },
  "sleepingHitboxFiles": [
    "jarvis-sleeping.svg"
  ],
  "miniMode": {
    "supported": false
  },
  "timings": {
    "minDisplay": {
      "attention": 2500
    },
    "autoReturn": {
      "attention": 4000
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  }
}
