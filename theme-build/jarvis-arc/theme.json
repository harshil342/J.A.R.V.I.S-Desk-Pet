{
  "schemaVersion": 1,
  "name": "J.A.R.V.I.S",
  "author": "DeskPet Jarvis",
  "version": "1.0.0",
  "description": "Pure arc-reactor HUD: concentric tick/dash rings, hex frame, glowing core. Rings spin up and the core flares while the model generates text.",
  "viewBox": { "x": 0, "y": 0, "width": 200, "height": 200 },
  "layout": {
    "contentBox": { "x": 6, "y": 6, "width": 188, "height": 188 },
    "centerX": 100,
    "baselineY": 192,
    "visibleHeightRatio": 0.55,
    "baselineBottomRatio": 0.03
  },
  "eyeTracking": { "enabled": false },
  "sleepSequence": { "mode": "full" },
  "states": {
    "idle": ["arc-idle.svg"],
    "yawning": ["arc-yawning.svg"],
    "dozing": ["arc-dozing.svg"],
    "collapsing": ["arc-collapsing.svg"],
    "sleeping": ["arc-sleeping.svg"],
    "waking": ["arc-waking.svg"],
    "thinking": ["arc-thinking.svg"],
    "working": ["arc-working.svg"],
    "juggling": ["arc-juggling.svg"],
    "sweeping": ["arc-sweeping.svg"],
    "carrying": ["arc-carrying.svg"],
    "error": ["arc-error.svg"],
    "attention": ["arc-attention.svg"],
    "notification": ["arc-notification.svg"]
  },
  "workingTiers": [
    { "minSessions": 3, "file": "arc-building.svg" },
    { "minSessions": 2, "file": "arc-juggling.svg" },
    { "minSessions": 1, "file": "arc-working.svg" }
  ],
  "reactions": {
    "drag": { "file": "arc-react-drag.svg" },
    "clickLeft": { "file": "arc-react-spark.svg", "duration": 2500 },
    "double": { "files": ["arc-react-spark.svg"], "duration": 3000 },
    "annoyed": { "file": "arc-react-annoyed.svg", "duration": 3500 }
  },
  "hitBoxes": {
    "default": { "x": 12, "y": 12, "w": 176, "h": 176 },
    "sleeping": { "x": 30, "y": 30, "w": 140, "h": 140 }
  },
  "sleepingHitboxFiles": ["arc-sleeping.svg"],
  "miniMode": { "supported": false },
  "timings": {
    "minDisplay": { "attention": 3000 },
    "autoReturn": { "attention": 4000 },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  }
}
